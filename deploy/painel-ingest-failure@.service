# Modelo acionado por OnFailure= das unidades painel-ingest*.service (%i = unidade que falhou): envia o aviso
# quando o pipeline não conseguiu avisar sozinho.
[Unit]
Description=Painel Público: aviso de falha de %i

[Service]
Type=oneshot
User=painel
WorkingDirectory=/opt/painel/app
Environment=PAINEL_DB=/opt/painel/data/na-lupa.sqlite3
EnvironmentFile=-/etc/painel/pipeline.env
ExecStart=/opt/painel/venv/bin/python3 -m ingest.pipeline notify-failure --unit %i
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/opt/painel/app
ReadWritePaths=/opt/painel/data
